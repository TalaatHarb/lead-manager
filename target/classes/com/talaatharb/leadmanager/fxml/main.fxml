<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.talaatharb.leadmanager.ui.controller.MainController"
            prefWidth="1280" prefHeight="800">

    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="Exit" onAction="#handleExit"/>
            </Menu>
            <Menu text="Leads">
                <MenuItem text="New Lead"   onAction="#handleNew"/>
                <MenuItem text="Save Lead"  onAction="#handleSave"/>
                <MenuItem text="Delete Lead" onAction="#handleDelete"/>
            </Menu>
            <Menu text="Scraper">
                <MenuItem text="Run Scraper" onAction="#handleRunScraper"/>
            </Menu>
        </MenuBar>
    </top>

    <center>
        <TabPane fx:id="mainTabPane">

            <!-- =================== LEADS TAB =================== -->
            <Tab text="Sales Leads" closable="false">
                <SplitPane dividerPositions="0.6">

                    <!-- Left: table -->
                    <VBox spacing="6" VBox.vgrow="ALWAYS">
                        <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                        <HBox spacing="6">
                            <Button text="New"    onAction="#handleNew"/>
                            <Button text="Save"   onAction="#handleSave"/>
                            <Button text="Delete" onAction="#handleDelete"/>
                        </HBox>
                        <TableView fx:id="leadsTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colName"    text="Name"    prefWidth="160"/>
                                <TableColumn fx:id="colCompany" text="Company" prefWidth="160"/>
                                <TableColumn fx:id="colEmail"   text="Email"   prefWidth="200"/>
                                <TableColumn fx:id="colStatus"  text="Status"  prefWidth="100"/>
                                <TableColumn fx:id="colSource"  text="Source"  prefWidth="140"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- Right: edit form -->
                    <ScrollPane fitToWidth="true">
                        <GridPane hgap="10" vgap="10">
                            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                            <columnConstraints>
                                <ColumnConstraints minWidth="100"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Name:"    GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="tfName"    GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Company:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="tfCompany" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Email:"   GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextField fx:id="tfEmail"   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Phone:"   GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <TextField fx:id="tfPhone"   GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                            <Label text="Website:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <TextField fx:id="tfWebsite" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                            <Label text="Source:"  GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                            <TextField fx:id="tfSource"  GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                            <Label text="Status:"  GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="cbStatus"   GridPane.rowIndex="6" GridPane.columnIndex="1"
                                      maxWidth="Infinity"/>

                            <Label text="Notes:"   GridPane.rowIndex="7" GridPane.columnIndex="0"
                                   GridPane.valignment="TOP"/>
                            <TextArea fx:id="taNotes"    GridPane.rowIndex="7" GridPane.columnIndex="1"
                                      prefRowCount="5" wrapText="true"/>
                        </GridPane>
                    </ScrollPane>

                </SplitPane>
            </Tab>

            <!-- =================== SCRAPER TAB =================== -->
            <Tab text="Scraper" closable="false">
                <VBox spacing="10">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Scraper:"/>
                        <ComboBox fx:id="cbScraper" prefWidth="200"/>
                        <Button text="Run" onAction="#handleRunScraper"/>
                    </HBox>
                    <TextArea fx:id="taScraperLog" VBox.vgrow="ALWAYS" editable="false"
                              wrapText="true" prefRowCount="20"
                              style="-fx-font-family: monospace;"/>
                </VBox>
            </Tab>

            <!-- =================== CODE EDITOR TAB =================== -->
            <Tab text="Script Editor" closable="false">
                <BorderPane fx:id="editorPane"/>
            </Tab>

            <!-- =================== GRAPH EDITOR TAB =================== -->
            <Tab text="Graph Editor" closable="false">
                <BorderPane fx:id="graphPane"/>
            </Tab>

        </TabPane>
    </center>

    <bottom>
        <Label fx:id="statusBar" text="Ready" style="-fx-padding: 4 8 4 8;"/>
    </bottom>

</BorderPane>
